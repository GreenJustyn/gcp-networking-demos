#!/bin/bash
exec 5> startup_script_deb.txt
BASH_XTRACEFD="5"
PS4='$LINENO: '
set -x

# Enable IP forwarding:
echo 1 > /proc/sys/net/ipv4/ip_forward
echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/20-iptables.conf
# Read VM network configuration:
md_vm="http://metadata.google.internal/computeMetadata/v1/instance/"
md_net="$md_vm/network-interfaces"
NIC0_ADDR="$(curl $md_net/0/ip -H "Metadata-Flavor:Google")"
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install bird

cat <<EOF > /etc/bird/bird.conf
router id $NIC0_ADDR;
protocol kernel {
        scan time 60;
        import none;
}
protocol device {
        scan time 60;
}
log syslog { debug, trace, info, remote, warning, error, auth, fatal, bug };
log stderr all;
protocol bgp {
  description "BIRD BGP CONFIG";
  local as ${appliance_ext_asn};
  neighbor ${cr_ext_ip} as ${cr_ext_asn};
  multihop;
  graceful restart;
  import all;
  export all;
}
protocol bgp {
  description "BIRD BGP CONFIG";
  local as ${appliance_int_asn};
  neighbor ${cr_int_ip} as ${cr_int_asn};
  multihop;
  graceful restart;
  import all;
  export all;
}
EOF
systemctl restart bird
systemctl enable bird