#!/bin/bash
exec 5> startup_script_deb.txt
BASH_XTRACEFD="5"
PS4='$LINENO: '
set -x
export DEBIAN_FRONTEND=noninteractive
apt-get remove -y --purge man-db
apt-get update
apt-get install tcpdump dnsutils npm -y
npm install http-echo-server pm2 -g
cat <<EOF > /etc/skel/.bash_aliases
alias startuplog='sudo journalctl -u google-startup-scripts.service'
alias ll=​'ls -alh'
EOF
pm2 --name echoserver start http-echo-server 80
